void startFallbackAccessPoint(){if(apActive||autarkMode)return;WiFi.mode(WIFI_AP_STA);WiFi.softAPConfig(FALLBACK_AP_IP,FALLBACK_AP_GATEWAY,FALLBACK_AP_SUBNET);apActive=WiFi.softAP(FALLBACK_AP_SSID);} void stopFallbackAccessPoint(){if(!apActive)return;WiFi.softAPdisconnect(true);apActive=false;if(WiFi.status()==WL_CONNECTED)WiFi.mode(WIFI_STA);} void connectWifi(){startFallbackAccessPoint();WiFi.setHostname(HOSTNAME);WiFi.setAutoReconnect(true);WiFi.begin(WIFI_SSID,WIFI_PASSWORD);lastWifiRetry=millis();} void setupTime(){configTzTime(TZ_INFO,primaryNtp.c_str(),NTP_2,NTP_3);} void setupMdns(){if(!mdnsStarted&&WiFi.status()==WL_CONNECTED&&MDNS.begin(HOSTNAME)){MDNS.addService("http","tcp",80);mdnsStarted=true;}} void stopNetworkForAutark(){if(mdnsStarted){MDNS.end();mdnsStarted=false;}if(webServerStarted){server.stop();webServerStarted=false;}if(apActive){WiFi.softAPdisconnect(true);apActive=false;}WiFi.setAutoReconnect(false);WiFi.disconnect(true,true);WiFi.mode(WIFI_OFF);} void configureAutarkWake(){gpio_wakeup_enable((gpio_num_t)BUTTON_PIN,GPIO_INTR_LOW_LEVEL);gpio_wakeup_enable((gpio_num_t)AUTARK_PIN,GPIO_INTR_HIGH_LEVEL);esp_sleep_enable_gpio_wakeup();} void enterAutarkMode(){if(autarkMode)return;autarkMode=true;autarkSessionId=autarkHeader.nextSessionId++;{File f=LittleFS.open(AUTARK_FILE,"r+");if(f){writeAutarkHeader(f);f.close();}}autarkSessionEvents=0;autarkSessionStartUs=(uint64_t)esp_timer_get_time();appendAutarkRecord(AUTARK_START,autarkSessionId,0,timeIsValid()?(uint32_t)time(nullptr):0);stopNetworkForAutark();setCpuFrequencyMhz(80);configureAutarkWake();led(false);} void exitAutarkMode(){if(!autarkMode)return;uint32_t e=currentAutarkElapsed(),s=autarkSessionId;appendAutarkRecord(AUTARK_END,s,e,0);pendingAutarkEndSession=s;lastAutarkElapsed=e;autarkMode=false;autarkSessionStartUs=0;gpio_wakeup_disable((gpio_num_t)BUTTON_PIN);gpio_wakeup_disable((gpio_num_t)AUTARK_PIN);setCpuFrequencyMhz(240);connectWifi();setupTime();setupWebServer();} void processAutarkSwitch(){bool r=digitalRead(AUTARK_PIN);if(r!=autarkRaw){autarkRaw=r;autarkChangedAt=millis();}if(millis()-autarkChangedAt<80||autarkStable==autarkRaw)return;autarkStable=autarkRaw;if(autarkStable==LOW)enterAutarkMode();else exitAutarkMode();} void autarkIdleSleep(){if(autarkMode&&digitalRead(AUTARK_PIN)==LOW&&digitalRead(BUTTON_PIN)==HIGH&&buttonRaw==buttonStable&&millis()-rawChangedAt>=DEBOUNCE_MS)esp_light_sleep_start();} void maintainWifi(){if(autarkMode)return;if(WiFi.status()==WL_CONNECTED){if(apActive)stopFallbackAccessPoint();setupMdns();if(timeIsValid()&&timeSource=="none")timeSource="ntp";if(pendingAutarkEndSession&&timeIsValid()){updateLastAutarkEndAnchor(pendingAutarkEndSession,(uint32_t)time(nullptr));pendingAutarkEndSession=0;}return;}if(mdnsStarted){MDNS.end();mdnsStarted=false;}if(!apActive)startFallbackAccessPoint();if(millis()-lastWifiRetry<WIFI_RETRY_MS)return;lastWifiRetry=millis();WiFi.disconnect();WiFi.begin(WIFI_SSID,WIFI_PASSWORD);}
void processButton(){bool r=digitalRead(BUTTON_PIN);if(r!=buttonRaw){buttonRaw=r;rawChangedAt=millis();}if(millis()-rawChangedAt<DEBOUNCE_MS||buttonStable==buttonRaw)return;buttonStable=buttonRaw;if(buttonStable==LOW){pressedAt=millis();led(true);return;}led(false);uint32_t d=millis()-pressedAt;if(d>=LONG_PRESS_MS){bool ok=autarkMode?deleteLastAutarkEvent():deleteLastEvent();if(ok){noteUiAction(2);blinkDeleteOk();}else blinkWarning();return;}if(autarkMode){uint32_t e=currentAutarkElapsed();if(!appendAutarkRecord(AUTARK_EVENT,autarkSessionId,e,0)){blinkWarning();return;}autarkSessionEvents++;physicalPulseSeq++;noteUiAction(1);blink(1,70,0);return;}if(!timeIsValid()||!appendEvent(time(nullptr))){blinkWarning();return;}physicalPulseSeq++;noteUiAction(1);if(WiFi.status()!=WL_CONNECTED)blinkWarning();else blink(1,90,0);}
void setup(){Serial.begin(115200);delay(300);pinMode(BUTTON_PIN,INPUT_PULLUP);pinMode(AUTARK_PIN,INPUT_PULLUP);pinMode(LED_PIN,OUTPUT);led(false);loadNtpConfig();fsOk=LittleFS.begin(false);if(!fsOk)fsOk=LittleFS.begin(true);if(fsOk){ringOk=initRing();if(ringOk)migrateLegacyEvents();autarkRingOk=initAutarkRing();if(autarkRingOk)restoreAutarkSummary();}autarkRaw=autarkStable=digitalRead(AUTARK_PIN);if(autarkStable==LOW&&autarkRingOk)enterAutarkMode();else{connectWifi();setupTime();setupWebServer();if(fsOk&&ringOk)blink(2,80,80);}} void loop(){processAutarkSwitch();processButton();if(autarkMode){autarkIdleSleep();delay(2);return;}if(webServerStarted)server.handleClient();maintainWifi();delay(1);}
